# ==== STRIPE (DEVELOPMENT) ====
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==== FIREBASE ====
# Paste a minimal service account JSON (placeholder) or provide via environment
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project"}

# ==== RESEND (EMAIL) ====
RESEND_API_KEY=re_your_key_here

# ==== SENTRY (OPTIONAL) ====
SENTRY_DSN=https://your_sentry_dsn_here

# ==== VERCEL ====
VERCEL_OIDC_TOKEN=your_token_here

# ==== GITHUB INVENTORY TRACKING ====
ENABLE_GITHUB_INVENTORY=false
GITHUB_OWNER=your-github-username
GITHUB_REPO=electricink-ie
GITHUB_BRANCH=main
GITHUB_TOKEN=ghp_your_token_here

# ==== NOTES ====
# Copy this file to .env and replace placeholders with REAL values for local development.
# NEVER commit .env with secrets. This .env.example contains ONLY placeholders and is safe to commit.