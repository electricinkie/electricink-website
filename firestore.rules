rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if authenticated user has an admins/{uid} document
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: check if user is viewing their own order
    function isOwnOrder() {
      return request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        resource.data.customerEmail == request.auth.token.email
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders collection - CRITICAL CHANGE HERE
    match /orders/{orderId} {
      // Admin pode tudo (get e list)
      allow read: if isAdmin();
      
      // User pode:
      // - GET um pedido específico se for dele
      allow get: if isOwnOrder();
      
      // - LIST/QUERY pedidos dele (CRÍTICO PARA MY ORDERS!)
      allow list: if request.auth != null && (
        // Query filtra por userId == UID
        request.query.limit <= 100 &&
        (
          // Query where userId == uid
          ('userId' in request.query.filters() && request.query.filters().userId == request.auth.uid) ||
          // Query where userId == email  
          ('userId' in request.query.filters() && request.query.filters().userId == request.auth.token.email) ||
          // Query where customerEmail == email
          ('customerEmail' in request.query.filters() && request.query.filters().customerEmail == request.auth.token.email)
        )
      );
      
      // Só admin/backend pode escrever
      allow create, update, delete: if isAdmin();
    }

    // Order events: admin-only
    match /order-events/{eventId} {
      allow read, write: if isAdmin();
    }

    // Counters: backend only
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}