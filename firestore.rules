rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if authenticated user has an admins/{uid} document
    // Admin check: prefer token claim for speed, but fall back to admins/{uid} doc.
    function isAdmin() {
      return request.auth != null && (
        // Fast path: custom claim set by admin SDK (scripts/set-admin.js, scripts/create-admin.js)
        (request.auth.token.admin == true) ||
        // Fallback: legacy admins collection document
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Helper: check if user is viewing their own order
    function isOwnOrder() {
      return request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        resource.data.customerEmail == request.auth.token.email
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders collection - CRITICAL CHANGE HERE
    match /orders/{orderId} {
      // Admin pode tudo (leitura completa)
      allow read: if isAdmin();

      // Usuário pode obter (`get`) um pedido específico se for proprietário
      allow get: if isOwnOrder();

      // IMPORTANT: Disallow client-side LIST queries entirely to force use of
      // server-side endpoint (/api/my-orders). Listing can leak large data and
      // is error-prone with complex query restrictions. Clients must call the
      // authenticated server endpoint which performs safe server-side queries.
      allow list: if false;

      // Só admin/backend pode escrever
      allow create, update, delete: if isAdmin();
    }

    // Order events: admin-only
    match /order-events/{eventId} {
      allow read, write: if isAdmin();
    }

    // Counters: backend only
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}